"""Minimal types-aioboto3 / aioboto3-stubs Session — must stay non-sink."""

class _AioClient:
    async def __aenter__(self) -> "_AioClient": ...
    async def __aexit__(self, *args: object) -> None: ...
    async def get_object(self, *args: object, **kwargs: object) -> object: ...
    async def list_objects_v2(self, *args: object, **kwargs: object) -> object: ...

class Session:
    def client(self, service_name: str, *args: object, **kwargs: object) -> _AioClient: ...
    def resource(self, service_name: str, *args: object, **kwargs: object) -> _AioClient: ...
